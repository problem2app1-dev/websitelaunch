# Copy to .env.local for local development. Never commit keys.
# Resend server key; never prefix server secrets with VITE_.
RESEND_API_KEY=
# Use an address on a domain verified in your Resend account.
CONTACT_FROM=
CONTACT_TO=problem2app@gmail.com

# Optional studio sample invoice delivery. A fixed owner-controlled inbox only.
INVOICE_DEMO_EMAIL_ENABLED=false
INVOICE_DEMO_TO=

# Public Vapi web-call configuration. These are browser-visible, not private keys.
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=

# Only relevant to `npm start`; Vite already has a local preview inbox.
LOCAL_CONTACT_STORAGE=false
